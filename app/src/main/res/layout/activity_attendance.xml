<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/jmb_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/backFromAttendanceButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="← Dashboard" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Attendance"
            android:textColor="@color/jmb_navy" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:id="@+id/attendanceDateText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="Attendance for today"
            android:textColor="@color/jmb_muted" android:textSize="14sp" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardBackgroundColor="#FFF7E6"
            app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:strokeColor="#F4D9A1" app:strokeWidth="1dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="DEMO ATTENDANCE • Saved only on this device. Do not use for a real class register."
                android:textColor="#75510A" android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/attendanceSummaryText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Present: 0 • Absent: 0 • Not marked: 0"
            android:textColor="@color/jmb_text" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/attendanceListContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton android:id="@+id/saveAttendanceButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Save demo attendance"
            app:cornerRadius="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center"
            android:text="A local prototype only • No cloud sync"
            android:textColor="@color/jmb_muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>