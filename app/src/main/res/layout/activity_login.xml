<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/jmb_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
        <ImageView android:layout_width="112dp" android:layout_height="112dp"
            android:contentDescription="JMB EDU logo" android:src="@drawable/ic_jmb_edu_logo" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="JMB EDU" android:textColor="@color/jmb_navy"
            android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="School Management System"
            android:textColor="@color/jmb_muted" android:textSize="14sp" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" app:cardCornerRadius="20dp" app:cardElevation="2dp"
            app:strokeColor="#E0E8F5" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Welcome back" android:textColor="@color/jmb_text"
                    android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Choose a role to preview the workspace. Secure sign-in is still being set up."
                    android:textColor="@color/jmb_muted" android:textSize="14sp" />
                <Spinner android:id="@+id/roleSpinner" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="16dp"
                    android:entries="@array/login_roles" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="Email address">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="Password"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:autofillHints="password"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signInButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp"
                    android:text="Sign in" app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previewDemoButton" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Explore Demo Dashboard"
                    app:cornerRadius="12dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:gravity="center"
                    android:text="DEMO PREVIEW ONLY • No account is created. Avoid entering real passwords or real student information."
                    android:textColor="@color/jmb_muted" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="LEARN  •  MANAGE  •  SUCCEED"
            android:textColor="@color/jmb_blue" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>