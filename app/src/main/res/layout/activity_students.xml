<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/jmb_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/backToDashboardButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="← Dashboard" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Student directory"
            android:textColor="@color/jmb_navy" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="Demo records • saved locally on this device only"
            android:textColor="@color/jmb_muted" android:textSize="13sp" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" app:cardBackgroundColor="#FFF7E6"
            app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:strokeColor="#F4D9A1" app:strokeWidth="1dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="For testing only. Do not enter real names, school IDs, addresses, marks, or other student information."
                android:textColor="#75510A" android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" app:cardCornerRadius="18dp" app:cardElevation="1dp"
            app:strokeColor="#E0E8F5" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Add a sample student" android:textColor="@color/jmb_text"
                    android:textSize="18sp" android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:hint="Sample name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/studentNameInput" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:hint="Class or grade">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/studentClassInput" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/addStudentButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="Add sample student"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/studentCountText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:text="Sample students (0)" android:textColor="@color/jmb_text"
            android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/studentListContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>